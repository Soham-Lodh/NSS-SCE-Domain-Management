# ---------------------------------------------------------------------------
# NSS SCE KIIT Domain Management Platform — environment template
# Copy to .env.local and fill with real values. NEVER commit real secrets.
# ---------------------------------------------------------------------------

# ---- Application ----
# Public base URL of the deployment (used for OAuth redirect + origin checks).
APP_URL="http://localhost:3000"
# Organization timezone used for DISPLAY only. Timestamps are stored in UTC.
ORGANIZATION_TIMEZONE="Asia/Kolkata"

# ---- Supabase Auth + Postgres ----
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
# Publishable/anon key — safe for the browser (never the service-role key).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="<publishable-anon-key>"

# Runtime traffic → Supabase transaction pooler (pgbouncer).
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# Migrations/CLI → direct connection.
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres"

# ---- Access control ----
# Exact, comma-separated institutional email domain suffixes (no substrings).
# Confirm the canonical KIIT suffix with the project owner before launch.
ALLOWED_EMAIL_DOMAINS="kiit.ac.in"
# First-ever coordinator bootstrap (optional). Only used to seed the FIRST
# coordinator on an empty database; ignored afterwards. Keep empty in code repos.
BOOTSTRAP_COORDINATOR_EMAIL=""

# ---- Brevo transactional email (SMTP) ----
BREVO_SMTP_HOST="smtp-relay.brevo.com"
BREVO_SMTP_PORT="587"
BREVO_SMTP_USER="<brevo-smtp-login>"
BREVO_SMTP_PASSWORD="<brevo-smtp-key>"
MAIL_FROM="no-reply@<verified-sender-domain>"
MAIL_FROM_NAME="NSS SCE KIIT"

# ---- Optional / tuning ----
# Comma-separated extra allowed origins for cookie-authenticated mutations.
ALLOWED_ORIGINS=""
# Bearer secret for the scheduled outbox worker (/api/cron/outbox).
CRON_SECRET="<random-long-secret>"
# Log level for structured server telemetry.
LOG_LEVEL="info"
